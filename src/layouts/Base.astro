---
/**
 * HTML document shell for every page: head metadata, fonts, the global
 * stylesheet, and a skip link. Page content (nav, <main id="main">) comes
 * from the default slot.
 */
import '../styles/global.css';

interface Props {
  /** Text for the <title> element. */
  title: string;
  /** Text for the meta description. */
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Montserrat:wght@400;500;600;700&family=Roboto+Serif:wght@400;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
